<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_medicine"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Цветной индикатор -->
        <View
            android:id="@+id/view_status_indicator"
            android:layout_width="5dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Название -->
            <TextView
                android:id="@+id/text_medicine_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Название препарата"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- Категория -->
            <TextView
                android:id="@+id/text_medicine_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Обезболивающие"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Количество -->
            <TextView
                android:id="@+id/text_medicine_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Количество: 10 шт."
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Срок -->
            <TextView
                android:id="@+id/text_medicine_expiration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Срок годности: 01.10.2026"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Статус -->
            <TextView
                android:id="@+id/text_medicine_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="В порядке"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>